# Environment variables for mc_copy_number_processing
# Copy this file to .env and fill in the values for your environment

# Application settings (add any secrets/credentials here)
# MC_SOME_API_KEY=your_api_key_here

# SMTP settings for status emails
SRD_SMTP_SERVER=smtp.your-domain.example
SRD_SMTP_SERVER_PORT=25

# Metadata database connection (used for aliquot validation)
MC_DB_DRIVER=ODBC Driver 18 for SQL Server
MC_DB_SERVER=your-db-server.example
MC_DB_NAME=your_database_name
MC_DB_USER_NAME=your_db_user
MC_DB_USER_PWD=your_db_password
